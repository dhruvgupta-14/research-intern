# Copy to .env for local development. On Render, set these as environment
# variables in the dashboard instead - .env is never committed.

PORT=5000

# Sign the login tokens. Use a long random string; changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Browser origins allowed to call this API. Comma-separated.
# Local dev:  http://localhost:5173
# Deployed:   https://<your-app>.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# The two dashboard accounts. `npm start` reseeds data/users.json from these,
# so changing a password here and restarting is all it takes.
USER1_NAME=supervisor
USER1_PASS=change-me
USER2_NAME=intern
USER2_PASS=change-me

# Used to build the GitHub links shown against every file. No token needed -
# the corpus is read from disk, GitHub is only used to address it.
GITHUB_OWNER=your-github-username
GITHUB_REPO=research_intern
GITHUB_BRANCH=main

# Where the six category folders live. Defaults to the parent of this
# directory, which is correct both locally and on Render when the whole
# repository is cloned. Only set this if the corpus lives somewhere else.
# CORPUS_ROOT=/opt/render/project/src
