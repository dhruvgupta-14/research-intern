# Copy to .env for local development. On Vercel, set this as a Project
# Environment Variable instead - .env is never committed.
#
# Read at BUILD time, not runtime: changing it on Vercel needs a redeploy,
# not just a restart.
#
# Local dev:  http://localhost:5000/api
# Deployed:   https://<your-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api
